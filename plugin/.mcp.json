{
  "mcpServers": {
    "nexusmind": {
      "command": "npx",
      "args": [
        "-y",
        "@smart-coder-labs/nexusmind-mcp@0.18.0"
      ],
      "env": {
        "NEXUSMIND_API_KEY": "${NEXUSMIND_API_KEY}",
        "NEXUSMIND_BASE_URL": "${NEXUSMIND_BASE_URL}",
        "NEXUSMIND_MCP_TOOL_PROFILE": "${NEXUSMIND_MCP_TOOL_PROFILE:-essential}"
      }
    }
  }
}
